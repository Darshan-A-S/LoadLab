{
  "name": "loadlab",
  "version": "0.1.4",
  "description": "Local-first load testing for developers",
  "author": "Darshan A S <asdarshan10@gmail.com>",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "debug": "electron-vite dev --inspect=9229 --remoteDebuggingPort=9222 --sourcemap",
    "debug:devtools": "electron-vite dev --inspect=9229 --remoteDebuggingPort=9222 --sourcemap -- --devtools",
    "debug:brk": "electron-vite dev --inspectBrk=9229 --sourcemap",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "selfcheck": "node scripts/selfcheck.mjs",
    "download:engines": "node scripts/download-engines.mjs",
    "generate:icons": "python scripts/generate-icons.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "autocannon": "^7.15.0",
    "loadtest": "^8.2.1"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "lucide-react": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "dev.loadlab.app",
    "productName": "LoadLab",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      "bin/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/win/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icons/mac/icon.icns"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icons/png",
      "category": "Development",
      "maintainer": "Darshan A S <asdarshan10@gmail.com>"
    },
    "publish": {
      "provider": "github",
      "owner": "Darshan-A-S",
      "repo": "LoadLab",
      "releaseType": "release"
    }
  }
}
